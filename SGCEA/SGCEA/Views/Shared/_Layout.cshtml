<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – SGCEA</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- TOPBAR -->
    <header class="topbar">
        <a class="topbar-brand" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo.png" alt="Logo SGCEA" />
            <span>SGCEA</span>
        </a>
        <div class="topbar-user">
            <span><i class="fa fa-user-circle me-1"></i> @User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <i class="fa fa-sign-out-alt me-1"></i> Salir
                </button>
            </form>
        </div>
    </header>

    <!-- SIDEBAR -->
    <nav class="sidebar">
        <span class="sidebar-section">Principal</span>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
           asp-controller="Home" asp-action="Index">
            <i class="fa fa-home"></i> Inicio
        </a>

        <span class="sidebar-section">Gestión</span>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdultoMayor" ? "active" : "")"
           asp-controller="AdultoMayor" asp-action="Index">
            <i class="fa fa-users"></i> Adultos Mayores
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asistencia" ? "active" : "")"
           asp-controller="Asistencia" asp-action="Index">
            <i class="fa fa-clipboard-check"></i> Asistencias
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Actividad" ? "active" : "")"
           asp-controller="Actividad" asp-action="Index">
            <i class="fa fa-calendar-alt"></i> Actividades
        </a>

        <span class="sidebar-section">Sistema</span>
        <a class="nav-link" asp-controller="Account" asp-action="Login">
            <i class="fa fa-cog"></i> Configuración
        </a>
    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-wrapper">
        <main class="main-content">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success mb-3">
                    <i class="fa fa-check-circle me-2"></i>@TempData["Exito"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="footer">
            <div class="footer-logo">
                <img src="~/img/logo.png" alt="Logo" />
                <span>Centro de Envejecimiento Activo<br />Luis Baudilio Víquez Arrieta</span>
            </div>
            <div class="footer-info">
                Mercedes Norte, Heredia &nbsp;|&nbsp; Tel: 6243-1193 &nbsp;|&nbsp; cristhinaporrasmu.oz@gmail.com
            </div>
            <div class="footer-copy">
                &copy; @DateTime.Now.Year SGCEA<br />Sistema de Gestión
            </div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>